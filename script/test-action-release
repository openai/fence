#! /usr/bin/env bash

set -euo pipefail

source script/env "$@"

require_cmd python3

python3 -B -E - "$DIR" <<'PY'
import copy
import hashlib
import json
import os
import pathlib
import subprocess
import tempfile
import textwrap
import sys
from unittest import mock
import urllib.error

root = pathlib.Path(sys.argv[1])
sys.path.insert(0, str(root / "script/lib"))
import action_release as module
import release_adoption as adoption


def expect_error(callable_value, message):
    try:
        callable_value()
    except ValueError:
        return
    raise SystemExit(message)


for valid in ("0.7.0", "1.2.3-rc.1", "1.2.3-alpha.beta", "10.20.30-0"):
    module.parse_semver(valid)
for invalid in ("01.2.3", "1.02.3", "1.2.03", "1.2.3-01", "1.2.3+build", "v1.2.3"):
    expect_error(lambda value=invalid: module.parse_semver(value), f"accepted invalid SemVer: {invalid}")
if module.release_channel("1.2.3") != "stable" or module.release_channel("1.2.3-rc.1") != "prerelease":
    raise SystemExit("stable/prerelease classification mismatch")
if module.compare_semver(module.parse_semver("1.2.3-rc.1"), module.parse_semver("1.2.3")) >= 0:
    raise SystemExit("SemVer prerelease precedence mismatch")
if module.compare_semver(module.parse_semver("1.2.4"), module.parse_semver("1.2.3")) <= 0:
    raise SystemExit("SemVer release precedence mismatch")

if module.select_exact_release([[]], "v0.7.0") != ("absent", None):
    raise SystemExit("absent release-state selection mismatch")
draft_release = {"tag_name": "v0.7.0", "draft": True}
published_release = {"tag_name": "v0.7.0", "draft": False}
if module.select_exact_release([[draft_release]], "v0.7.0") != ("draft", draft_release):
    raise SystemExit("draft release-state selection mismatch")
if module.select_exact_release([[published_release]], "v0.7.0") != ("published", published_release):
    raise SystemExit("published release-state selection mismatch")
expect_error(
    lambda: module.select_exact_release([[draft_release], [published_release]], "v0.7.0"),
    "accepted duplicate exact release records",
)

pages = [[
    {"tag_name": "v0.6.3", "draft": False},
    {"tag_name": "v0.7.0-rc.1", "draft": False},
    {"tag_name": "v9.0.0", "draft": True},
]]
module.validate_release_order("0.7.0", pages)
module.validate_release_order("0.7.0-rc.1", pages)
expect_error(lambda: module.validate_release_order("0.6.4", pages), "accepted a non-monotonic release")

with tempfile.TemporaryDirectory() as directory:
    temporary = pathlib.Path(directory)
    cargo = temporary / "Cargo.toml"
    lock = temporary / "Cargo.lock"
    cargo.write_text('[package]\nname = "fence"\nversion = "0.7.0"\n', encoding="utf-8")
    lock.write_text('version = 4\n\n[[package]]\nname = "fence"\nversion = "0.7.0"\n', encoding="utf-8")
    if module.validate_root_versions(cargo, lock) != ("fence", "0.7.0"):
        raise SystemExit("root Cargo identity mismatch")
    lock.write_text('version = 4\n\n[[package]]\nname = "fence"\nversion = "0.6.3"\n', encoding="utf-8")
    expect_error(lambda: module.validate_root_versions(cargo, lock), "accepted a Cargo.toml/Cargo.lock mismatch")

repository = "openai/fence"
version = "0.7.0"
source = "a" * 40
action = "b" * 40
other = "c" * 40
artifact = "fence_v0.7.0_linux-amd64"
digest = "d" * 64
mapping = module.expected_mapping(repository, version, source, action, artifact, digest)
if module.validate_mapping(mapping, repository, version, source, action, artifact, digest) != action:
    raise SystemExit("valid release mapping was rejected")
for field, value in (
    ("source_commit", other),
    ("action_commit", other),
    ("artifact_sha256", "e" * 64),
    ("artifact_name", "fence_v0.7.1_linux-amd64"),
    ("signer_digest", other),
):
    invalid = copy.deepcopy(mapping)
    invalid[field] = value
    expect_error(
        lambda candidate=invalid: module.validate_mapping(candidate, repository, version, source, action, artifact, digest),
        f"accepted conflicting release mapping field: {field}",
    )
missing = copy.deepcopy(mapping)
missing.pop("signer_workflow")
expect_error(lambda: module.validate_mapping(missing, repository, version, source, action, artifact, digest), "accepted missing mapping field")

def state(
    release_exists=False,
    release_mapping=None,
    tag_commit=None,
    candidate_head=None,
    verified_head=None,
    draft_commit=None,
    verification_succeeded=None,
):
    return {
        "release_exists": release_exists,
        "release_mapping": release_mapping,
        "tag_commit": tag_commit,
        "candidate_head": candidate_head,
        "draft_commit": draft_commit,
        "verification_succeeded": verification_succeeded,
        "verified_head": verified_head,
    }

cases = (
    (state(), "new", None),
    (state(candidate_head=source), "candidate-source", None),
    (state(candidate_head=action), "candidate", action),
    (state(tag_commit=action), "tag", action),
    (state(tag_commit=action, candidate_head=action), "tag", action),
    (state(draft_commit=action), "draft", action),
    (state(tag_commit=action, candidate_head=action, draft_commit=action), "draft", action),
    (state(True, mapping, action, None), "complete", action),
    (state(True, mapping, action, action, verification_succeeded=False), "withdrawn", action),
    (state(True, mapping, action, action, verification_succeeded=True), "complete", action),
    (state(True, mapping, action, action, action), "complete", action),
    (state(True, mapping, action, None, action), "complete", action),
)
for value, expected_state, expected_action in cases:
    result = module.classify_release_state(value, repository, version, source, artifact, digest)
    if result != {"state": expected_state, "action_commit": expected_action}:
        raise SystemExit(f"release state classification mismatch: {value}")

conflicts = (
    state(True, None, action, None),
    state(True, mapping, other, None),
    state(True, mapping, action, other),
    state(True, mapping, action, action, other),
    state(True, mapping, action, action),
    state(True, mapping, action, None, None, action),
    state(False, mapping, None, None),
    state(False, None, None, None, action),
    state(False, None, None, None, None, source),
    state(False, None, None, None, None, None, True),
    state(False, None, other, action, None, action),
    state(False, None, source, None),
    state(False, None, action, other),
)
for value in conflicts:
    expect_error(
        lambda candidate=value: module.classify_release_state(candidate, repository, version, source, artifact, digest),
        f"accepted conflicting release state: {value}",
    )
incomplete_state = state()
incomplete_state.pop("verified_head")
expect_error(
    lambda: module.classify_release_state(incomplete_state, repository, version, source, artifact, digest),
    "accepted release state without verification marker identity",
)

with tempfile.TemporaryDirectory() as directory:
    temporary = pathlib.Path(directory)
    asset_root = temporary / "assets"
    asset_root.mkdir()
    notes = temporary / "notes.md"
    notes.write_text(adoption.PENDING_NOTES + "\n", encoding="utf-8")
    asset_names = (
        artifact,
        f"{artifact}.tar.gz",
        "action-release.json",
        "checksums.txt",
    )
    for index, name in enumerate(asset_names):
        (asset_root / name).write_bytes(f"asset-{index}".encode())

    def draft_asset(name):
        path = asset_root / name
        return {
            "name": name,
            "state": "uploaded",
            "size": path.stat().st_size,
            "digest": f"sha256:{hashlib.sha256(path.read_bytes()).hexdigest()}",
            "uploader": {"login": "github-actions[bot]", "type": "Bot"},
        }

    draft = {
        "id": 7,
        "tag_name": "v0.7.0",
        "target_commitish": action,
        "name": "v0.7.0",
        "body": notes.read_text(encoding="utf-8"),
        "draft": True,
        "prerelease": True,
        "immutable": False,
        "published_at": None,
        "author": {"login": "github-actions[bot]", "type": "Bot"},
        "assets": [draft_asset(artifact), draft_asset("action-release.json")],
    }
    if module.validate_draft_release(draft, notes, asset_root, version, action) != 7:
        raise SystemExit("matching interrupted draft was rejected")
    for description, mutate in (
        ("target", lambda value: value.update(target_commitish=other)),
        ("notes", lambda value: value.update(body="different")),
        ("channel", lambda value: value.update(prerelease=False)),
        ("author", lambda value: value.update(author={"login": "maintainer", "type": "User"})),
        ("published state", lambda value: value.update(immutable=True)),
        ("asset digest", lambda value: value["assets"][0].update(digest="sha256:" + "0" * 64)),
        ("asset uploader", lambda value: value["assets"][0].update(uploader={"login": "maintainer", "type": "User"})),
        ("unknown asset", lambda value: value["assets"].append({**draft_asset(artifact), "name": "unknown"})),
    ):
        invalid = copy.deepcopy(draft)
        mutate(invalid)
        expect_error(
            lambda candidate=invalid: module.validate_draft_release(
                candidate,
                notes,
                asset_root,
                version,
                action,
            ),
            f"accepted conflicting draft {description}",
        )

rest = {
    "sha": action,
    "parents": [{"sha": source}],
    "files": [
        {"filename": "action/bin/fence", "status": "added"},
        {"filename": "action/bundle-manifest.json", "status": "added"},
    ],
    "commit": {"verification": {"verified": True}},
}
graphql = {
    "data": {
        "repository": {
            "object": {
                "oid": action,
                "signature": {"isValid": True, "wasSignedByGitHub": True},
            }
        }
    }
}
module.validate_distribution_rest(rest, source, action)
assert module.visible_distribution_signature(graphql, action) is True
invalid_parent = copy.deepcopy(rest)
invalid_parent["parents"] = [{"sha": other}]
invalid_diff = copy.deepcopy(rest)
invalid_diff["files"].append({"filename": "README.md", "status": "modified"})
invalid_rest_signature = copy.deepcopy(rest)
invalid_rest_signature["commit"]["verification"]["verified"] = False
invalid_github_signature = copy.deepcopy(graphql)
invalid_github_signature["data"]["repository"]["object"]["signature"]["wasSignedByGitHub"] = False
for description, invalid in (
    ("parent", invalid_parent), ("diff", invalid_diff), ("REST signature", invalid_rest_signature),
):
    expect_error(
        lambda: module.validate_distribution_rest(invalid, source, action),
        f"accepted conflicting distribution {description}",
    )

def http_error(status):
    return urllib.error.HTTPError("https://example.invalid", status, "test response", {}, None)


tag = f"v{version}"
publication = adoption.Publication(tag, source, action)
pending = {
    "id": 41, "tag_name": tag, "target_commitish": action, "draft": False,
    "immutable": True, "prerelease": True, "body": adoption.PENDING_NOTES,
}
release_id = pending["id"]
pin = f"- uses: openai/fence@{action} # pin@{tag}"
assert action not in pending["body"] and "uses:" not in pending["body"]
assert pin in publication.final_notes.splitlines()

with mock.patch.object(adoption.time, "sleep"):
    # Transient reads, then the right release before and after GitHub locks it.
    with mock.patch.object(adoption, "github", side_effect=[
        http_error(502), http_error(404), dict(pending, immutable=False), pending,
    ]):
        assert publication.wait() == (release_id, False)
    # Resolve the published tag once, using that same commit response. Only an
    # explicitly not-yet-visible GraphQL object, not an error or bad identity, can wait.
    tag_path = f"repos/openai/fence/commits/{tag}"
    not_visible = {"data": {"repository": {"object": None}}}
    verification_env = {"SOURCE_COMMIT": source, "ACTION_COMMIT": action, "VERSION_TAG": tag, "EXISTING_RELEASE": "false"}
    with (mock.patch.dict(os.environ, verification_env), mock.patch("builtins.print") as printed,
          mock.patch.object(adoption, "github", side_effect=[pending, http_error(502), rest, not_visible, graphql]) as api):
        adoption.main("verify")
        printed.assert_called_once_with(release_id)
        assert [call.args[0] for call in api.call_args_list[1:]] == [tag_path, tag_path, "graphql", "graphql"]
        assert api.call_args.kwargs["data"]["variables"]["oid"] == action
    for invalid in (None, invalid_parent, dict(rest, sha=other)):
        with mock.patch.object(adoption, "github", return_value=invalid) as api:
            expect_error(lambda: adoption.verify_commit(source, action, ref=tag), "accepted incorrect tag commit")
            api.assert_called_once_with(tag_path)
    with mock.patch.object(adoption, "github", side_effect=[rest] + [not_visible] * adoption.READ_ATTEMPTS) as api:
        expect_error(lambda: adoption.verify_commit(source, action), "accepted a commit that never became visible")
        assert api.call_count == 1 + adoption.READ_ATTEMPTS
    for invalid in (
        dict(not_visible, errors=[{"type": "FORBIDDEN"}]),
        {"data": {"repository": None}}, {"data": {"repository": {}}},
        {"data": {"repository": {"object": {"oid": other}}}}, invalid_github_signature,
    ):
        with mock.patch.object(adoption, "github", side_effect=[rest, invalid]):
            expect_error(lambda: adoption.verify_commit(source, action), "accepted a malformed or conflicting commit")

    for invalid in (
        http_error(401), http_error(403), dict(pending, tag_name="v9.9.9"),
        dict(pending, target_commitish=other), dict(pending, body=publication.final_notes),
        dict(pending, prerelease=False), dict(pending, draft=True), dict(pending, immutable=None),
    ):
        with mock.patch.object(adoption, "github", side_effect=[invalid]) as api:
            try:
                publication.wait()
            except (ValueError, urllib.error.HTTPError):
                pass
            else:
                raise SystemExit("accepted incorrect release metadata or authorization")
            api.assert_called_once()
    with mock.patch.object(adoption, "github", side_effect=http_error(404)) as api:
        expect_error(publication.wait, "accepted a release that never appeared")
        assert api.call_count == adoption.READ_ATTEMPTS

    # Withdrawal, unfinished cleanup, and a different release with the same tag.
    for blocked in (
        [[{"ref": f"refs/heads/release-candidate/{tag}"}]],
        [[], [{"ref": f"refs/heads/release-verified/{tag}"}]],
        [[], [], dict(pending, id=release_id + 1)],
    ):
        with mock.patch.object(adoption, "github", side_effect=blocked) as api:
            expect_error(lambda: publication.promote(release_id), "promoted an ineligible release")
            assert all(call.kwargs.get("method", "GET") == "GET" for call in api.call_args_list)

    for channel_tag in (tag, tag + "-rc.1"):
        release = adoption.Publication(channel_tag, source, action)
        initial = dict(pending, tag_name=channel_tag)
        final = dict(initial, body=release.final_notes, prerelease=release.prerelease)
        target = f"repos/openai/fence/releases/{release_id}"
        # Promotion response lost; confirm by GET, never a second PATCH. Genuine
        # prereleases must not displace the last verified stable release.
        responses = [[], [], initial, ConnectionResetError(), initial, final]
        if not release.prerelease:
            responses += [dict(id=release_id - 1), final]
        with mock.patch.object(adoption, "github", side_effect=responses) as api:
            release.promote(release_id)
            mutations = [call for call in api.call_args_list if call.kwargs.get("method", "GET") != "GET"]
            assert mutations == [mock.call(target, method="PATCH", data={
                "body": release.final_notes, "prerelease": release.prerelease,
                "make_latest": "false" if release.prerelease else "true",
            })]
        # Re-run after successful promotion: verify latest again, change nothing.
        latest = [] if release.prerelease else [final]
        with mock.patch.object(adoption, "github", side_effect=[[], [], final] + latest) as api:
            release.promote(release_id)
            assert all(call.kwargs.get("method", "GET") == "GET" for call in api.call_args_list)
            if not release.prerelease:
                assert api.call_args == mock.call("repos/openai/fence/releases/latest")

    # PATCH succeeds but stable Latest cannot be confirmed, including on a
    # subsequent full read-only verification. Neither attempt can report success.
    final = dict(pending, body=publication.final_notes, prerelease=False)
    previous = {"id": release_id - 1}
    for start, writes in (([pending, None, final], 1), ([final], 0)):
        responses = [[], []] + start + [previous] * adoption.READ_ATTEMPTS
        with mock.patch.object(adoption, "github", side_effect=responses) as api:
            expect_error(lambda: publication.promote(release_id), "advertised a stable release not confirmed Latest")
            assert sum(call.kwargs.get("method") == "PATCH" for call in api.call_args_list) == writes
            assert api.call_args == mock.call("repos/openai/fence/releases/latest")

    unconfirmed = [[], [], pending, TimeoutError()] + [pending] * adoption.READ_ATTEMPTS
    with mock.patch.object(adoption, "github", side_effect=unconfirmed) as api:
        expect_error(lambda: publication.promote(release_id), "advertised an unconfirmed release")
        assert sum(call.kwargs.get("method") == "PATCH" for call in api.call_args_list) == 1

# Exercise the actual no-permission finalizer. A guarded cleanup can correctly
# exit zero without promotion; its job result alone must never print the pin.
workflow = (root / ".github/workflows/release.yml").read_text(encoding="utf-8")
report = textwrap.dedent(workflow.split("\n  finalize-release:\n")[1].split("        run: |\n")[1])
with tempfile.TemporaryDirectory() as directory:
    summary = pathlib.Path(directory) / "summary"
    receipt = f"{action}:test-run:2"
    for proof in ("", f"{action}:test-run:1", f"{other}:test-run:2", receipt):
        attempt = subprocess.run(["/bin/bash", "-c", report], text=True, capture_output=True, check=False, env={
            "PATH": "", "SOURCE_COMMIT": source, "ACTION_COMMIT": action, "VERSION_TAG": tag,
            "GITHUB_RUN_ID": "test-run", "GITHUB_RUN_ATTEMPT": "2", "STATE_RUN_ATTEMPT": "2",
            "FINALIZED_PIN": proof, "GITHUB_STEP_SUMMARY": str(summary),
        })
        if proof == receipt:
            assert attempt.returncode == 0 and pin in summary.read_text(encoding="utf-8").splitlines()
        else:
            assert attempt.returncode != 0 and pin not in attempt.stdout and not summary.exists()

print("Action release state verified")
PY
